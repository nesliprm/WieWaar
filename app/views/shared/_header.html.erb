<header class="board-header">
  <div class="container-fluid px-4 py-3 d-flex align-items-center justify-content-between gap-4">
    <div class="d-flex align-items-center gap-3">
      <%= image_tag "kempen-logo.svg", alt: "Kempen", width: 48, height: 48 %>
      <div>
        <div class="board-header__brand">WieWaar <span>Kempen</span></div>
        <div class="board-header__sub">Kempen Automatisering</div>
      </div>
    </div>
    <%= yield :header_summary %>
    <div class="text-end">
      <div class="board-header__clock"><%= l(Time.current, format: "%H:%M") %></div>
      <div class="board-header__date"><%= l(Time.current.to_date, format: "%A %-d %B") %></div>
    </div>
  </div>
</header>
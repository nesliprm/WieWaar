<div class="container py-4">
  <% available = @ticketdienst.select { |t| available_for_duty?(t, @statuses) } %>
  <% missing = 2 - available.size %>
  <div class="alert <%= missing.positive? ? "alert-warning" : "alert-info" %> mb-4">
    <strong>Ticketdienst vandaag:</strong>
    <%= available.map { |t| t.employee.name }.to_sentence(two_words_connector: " & ", last_word_connector: " & ") %>
    <% if missing.positive? %>
      · nog <%= missing %> nodig
    <% end %>
    <% @ticketdienst.reject(&:employee).each do |t| %>
      <div class="small mt-1">Onbekende naam in de Ticketdienst-agenda: <strong><%= t.raw_name %></strong></div>
    <% end %>
  </div>
  <div class="row g-3">
    <% BoardHelper::ZONES.each do |zone| %>
      <% people = @statuses.select { |_employee, status| zone[:statuses].include?(status) } %>
      <div class="col-12 col-md-6 col-xl-4">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between">
            <strong><%= zone[:title] %></strong>
            <span class="text-secondary"><%= people.size %></span>
          </div>
          <ul class="list-group list-group-flush">
            <% people.each do |employee, status| %>
              <li class="list-group-item d-flex justify-content-between">
                <span><%= employee.name %></span>
                <%= status_badge(status) if zone[:statuses].size > 1 %>
              </li>
            <% end %>
            <% if people.empty? %>
              <li class="list-group-item text-secondary">-</li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
</div>